{
  "name": "Promoter tracker",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  },
  "updateContentCommand": "pip3 install --user -e '.[dev]' && (cd frontend && npm ci) && echo '✅ Packages installed'",
  "postAttachCommand": {
    "api": "uvicorn promoter_tracker.api:app --reload --port 8000",
    "web": "cd frontend && npm run dev -- --host"
  },
  "portsAttributes": {
    "5173": { "label": "Web (dev)", "onAutoForward": "openPreview" },
    "8000": { "label": "API" }
  },
  "forwardPorts": [5173, 8000]
}
