# Copy to .env and fill in what you use. docker compose reads .env automatically;
# for a local run, set these in your shell. Never commit .env.

# Link used in alert messages (optional)
PROMOTER_PUBLIC_URL=http://localhost:8000

# Telegram: create a bot with @BotFather, send it a message, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
PROMOTER_TELEGRAM_BOT_TOKEN=
PROMOTER_TELEGRAM_CHAT_ID=

# Email over SMTP (port 587 = STARTTLS, 465 = SSL). For Gmail use an app password.
PROMOTER_SMTP_HOST=
PROMOTER_SMTP_PORT=587
PROMOTER_SMTP_USER=
PROMOTER_SMTP_PASSWORD=
PROMOTER_SMTP_FROM=
PROMOTER_ALERT_EMAIL_TO=
